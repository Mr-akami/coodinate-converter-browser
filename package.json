{
  "name": "@mr-akami/proj-wasm-proj-data",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:lib": "tsc -p tsconfig.json",
    "test:unit": "vitest run",
    "test:native": "bash scripts/build-proj-native.sh && ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 build/native-tests/proj_wasm_tests",
    "test:browser": "node tests/run-browser-check.mjs",
    "build:data": "node scripts/build-data-dist.mjs",
    "prepack": "npm run typecheck && npm run test:unit"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "playwright": "^1.41.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "version": "0.1.0",
  "description": "PROJ coordinate transformation in the browser and on Node, as WebAssembly, fetching only the grids a transformation needs",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./src/proj-runtime.js",
    "./worker": "./src/proj-worker.js",
    "./wasm": "./dist/proj_wasm.wasm",
    "./testing": "./src/testing.js",
    "./node": "./src/node.js"
  },
  "files": [
    "src/**/*.js",
    "dist/proj_wasm.js",
    "dist/proj_wasm.wasm",
    "scripts/build-data-dist.mjs",
    "README.md"
  ]
}
